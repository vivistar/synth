# OpenRouter API key — server-side only.
# Read by api/ai.js via process.env.OPENROUTER_API_KEY. Never shipped to the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional admin gate.
# If set, the wired OPENROUTER_API_KEY is used ONLY when a request presents a matching
# admin unlock code (entered in the app's key popover, sent as the x-admin-unlock header).
# Leave unset to keep the shared key open to everyone.
ADMIN_UNLOCK=your_admin_unlock_code_here
